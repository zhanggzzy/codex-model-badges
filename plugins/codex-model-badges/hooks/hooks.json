          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_model_badges.py\"",
            "timeout": 5,
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT/hooks/codex_model_badges.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
